{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto mt-10 px-4">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-bold text-gray-900">
                Bonjour {{ app.user ? app.user.username : 'invité' }}
            </h1>
            {% if app.user %}
                <p class="text-gray-500">{{ app.user.email }}</p>
            {% endif %}
        </div>

        {# Bloc 1 : Statistiques dynamiques #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="bg-white rounded-lg shadow p-6 text-center">
                <p class="text-lg text-gray-600">Don réalisés</p>
                <p class="text-3xl font-bold text-green-600">{{ trocRealisesCount|default(0) }}</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6 text-center">
                <p class="text-lg text-gray-600">Don en cours</p>
                <p class="text-3xl font-bold text-yellow-500">{{ trocEnCoursCount|default(0) }}</p>
            </div>
            <a href="{{ path('app_message_inbox') }}"
               class="block bg-white rounded-lg shadow p-6 text-center hover:shadow-md hover:-translate-y-0.5 transition cursor-pointer">
                <p class="text-lg text-gray-600">Messages reçus</p>
                <p class="text-3xl font-bold text-blue-600 underline decoration-transparent hover:decoration-blue-600">
                    {{ messagesRecus|default(0) }}
                </p>
            </a>
        </div>

        {# Bloc A : Demandes de réservation en attente (reçues en tant que PROPRIÉTAIRE) #}
        <div class="bg-white rounded-lg shadow p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">Demandes de réservation reçues</h2>

            {% if reservationsEnAttente is defined and reservationsEnAttente|length > 0 %}
                <ul class="divide-y">
                    {% for reservation in reservationsEnAttente %}
                        <li class="py-3 flex items-center justify-between gap-4">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">
                                      En attente
                                    </span>
                                    <a href="{{ path('annonce_show', { id: reservation.annonce.id }) }}"
                                       class="font-medium text-gray-900 hover:underline truncate">
                                        {{ reservation.annonce.titre }}
                                    </a>
                                </div>
                                <div class="text-sm text-gray-600">
                                    Demande de
                                    <a href="{{ path('user_profile', { id: reservation.user.id }) }}"
                                       class="text-blue-600 hover:underline">
                                        {{ reservation.user.username }}
                                    </a>
                                    • le {{ reservation.createdAt|date('d/m/Y H:i') }}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <a href="{{ path('app_message_index', { id: reservation.annonce.id }) }}"
                                   class="px-3 py-1.5 rounded-md bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm"
                                   aria-label="Discuter au sujet de {{ reservation.annonce.titre }}">
                                    Discuter
                                </a>

                                <button type="button"
                                        class="px-3 py-1.5 rounded-md bg-green-600 hover:bg-green-700 text-white text-sm"
                                        onclick="confirmModeration(
                                            'accept-{{ reservation.id }}',
                                            'Accepter la demande',
                                            'Confirmer l’acceptation de la demande de {{ reservation.user.username|e('js') }} ?',
                                            'Accepter',
                                            'success'
                                            )"
                                        aria-label="Accepter la demande de {{ reservation.user.username }}">
                                    Accepter
                                </button>

                                <button type="button"
                                        class="px-3 py-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white text-sm"
                                        onclick="confirmModeration(
                                            'decline-{{ reservation.id }}',
                                            'Refuser la demande',
                                            'Refuser la demande de {{ reservation.user.username|e('js') }} ?',
                                            'Refuser',
                                            'warning'
                                            )"
                                        aria-label="Refuser la demande de {{ reservation.user.username }}">
                                    Refuser
                                </button>
                            </div>
                        </li>

                        {# Formulaires d’action #}
                        <form id="accept-{{ reservation.id }}" method="post"
                              action="{{ path('reservation_accept', { id: reservation.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('reservation_accept_' ~ reservation.id) }}">
                            <input type="submit" hidden>
                        </form>

                        <form id="decline-{{ reservation.id }}" method="post"
                              action="{{ path('reservation_decline', { id: reservation.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('reservation_decline_' ~ reservation.id) }}">
                            <input type="submit" hidden>
                        </form>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-gray-500 text-sm">Aucune demande pour le moment.</p>
            {% endif %}
        </div>

        {# Bloc B : MES demandes de réservation (envoyées en tant que DEMANDEUR) #}
        <div class="bg-white rounded-lg shadow p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">Demandes de réservation envoyées</h2>

            {% if mesReservations is defined and mesReservations|length > 0 %}
                <ul class="divide-y">
                    {% for r in mesReservations %}
                        {% set s = attribute(r.statut, 'value') ?? attribute(r.statut, 'name') ?? r.statut %}
                        <li class="py-3 flex items-center justify-between gap-4">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    {% if s == 'Pending' %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-700">En attente</span>
                                    {% elseif s == 'Accepted' %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Acceptée</span>
                                    {% elseif s == 'Refused' %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">Refusée</span>
                                    {% elseif s == 'Cancelled' %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">Annulée</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{{ s }}</span>
                                    {% endif %}

                                    <a href="{{ path('annonce_show', { id: r.annonce.id }) }}"
                                       class="font-medium text-gray-900 hover:underline truncate">
                                        {{ r.annonce.titre }}
                                    </a>
                                </div>
                                <div class="text-sm text-gray-600">
                                    Envoyée le {{ r.createdAt|date('d/m/Y H:i') }}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                {% if s == 'Accepted' %}
                                    <a href="{{ path('app_message_index', { id: r.annonce.id }) }}"
                                       class="px-3 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm"
                                       aria-label="Discuter au sujet de {{ r.annonce.titre }}">
                                        Discuter
                                    </a>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-gray-500 text-sm">Aucune demande envoyée.</p>
            {% endif %}
        </div>

        {# === Bloc C : Demandes de finalisation à confirmer (réceptionneur) === #}
        <div class="bg-white rounded-lg shadow p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">Finalisations à confirmer</h2>

            {% if finalisationsAConfirmer is defined and finalisationsAConfirmer|length > 0 %}
                <ul class="divide-y">
                    {% for a in finalisationsAConfirmer %}
                        <li class="py-3 flex items-center justify-between gap-4">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                        En attente de votre confirmation
                                    </span>
                                    <a href="{{ path('annonce_show', { id: a.id }) }}"
                                       class="font-medium text-gray-900 hover:underline truncate">
                                        {{ a.titre }}
                                    </a>
                                </div>
                                <div class="text-sm text-gray-600">
                                    Demande envoyée le {{ a.finishRequestedAt|date('d/m/Y H:i') }}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <a href="{{ path('app_message_index', { id: a.id }) }}"
                                   class="px-3 py-1.5 rounded-md bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm">
                                    Ouvrir la discussion
                                </a>

                                <form id="confirm-finish-{{ a.id }}"
                                      method="post"
                                      action="{{ path('discussion_confirm_finish', { id: a.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('confirm_finished_' ~ a.id ~ '_' ~ app.user.id) }}">
                                    <button class="px-3 py-1.5 rounded-md bg-green-600 hover:bg-green-700 text-white text-sm">
                                        Confirmer la réception
                                    </button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-gray-500 text-sm">Aucune finalisation en attente de votre confirmation.</p>
            {% endif %}
        </div>

        {# === Bloc D : Mes notifications === #}
        <div class="bg-white rounded-lg shadow p-6 mb-10">
            <h2 class="text-xl font-semibold mb-4">Mes notifications</h2>

            {% if notifications is defined and notifications|length > 0 %}
                <ul class="divide-y">
                    {% for n in notifications %}
                        <li class="py-3 flex items-start justify-between gap-4">
                            <div class="min-w-0">
                                <div class="font-medium text-gray-900">{{ n.titre }}</div>
                                <div class="text-sm text-gray-700">{{ n.message }}</div>
                                <div class="text-xs text-gray-500 mt-1">{{ n.createdAt|date('d/m/Y H:i') }}</div>
                            </div>

                            {% if n.link is defined and n.link %}
                                <a href="{{ n.link }}"
                                   class="px-3 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm">
                                    Voir
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-gray-500 text-sm">Aucune notification.</p>
            {% endif %}
        </div>

        {# Bloc 2 : Liens d’action #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="{{ path('mes_annonces') }}" class="block bg-gray-100 rounded-lg shadow p-6 text-center hover:bg-gray-200 transition">
                <p class="text-lg font-semibold text-gray-700">Mes annonces</p>
            </a>
            <a href="{{ path('app_profile_edit') }}" class="block bg-gray-100 rounded-lg shadow p-6 text-center hover:bg-gray-200 transition">
                <p class="text-lg font-semibold text-red-700">Modifier mon compte</p>
            </a>
            <a href="{{ path('app_home') }}" class="block bg-gray-100 rounded-lg shadow p-6 text-center hover:bg-gray-200 transition">
                <p class="text-lg font-semibold text-red-700">Mon avis</p>
            </a>
        </div>
    </div>

    {# ---------- SweetAlert2 + helpers ---------- #}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmModeration(formId, title, text, confirmText, mode) {
            Swal.fire({
                title: title,
                text: text,
                icon: mode === 'success' ? 'question' : 'warning',
                showCancelButton: true,
                confirmButtonText: confirmText,
                cancelButtonText: 'Annuler',
                buttonsStyling: false,
                customClass: {
                    popup: 'rounded-xl shadow-lg p-6',
                    title: 'text-xl font-bold text-gray-900',
                    htmlContainer: 'text-gray-700',
                    confirmButton: (mode === 'success'
                        ? 'bg-green-600 hover:bg-green-700'
                        : 'bg-red-600 hover:bg-red-700') + ' text-white font-semibold py-2 px-4 rounded-lg mr-2',
                    cancelButton: 'bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById(formId);
                    if (form) form.submit();
                }
            });
        }

        function showFlash(type, message) {
            const icon = (type === 'danger' || type === 'error') ? 'error'
                : (type === 'info' ? 'info'
                    : (type === 'warning' ? 'warning' : 'success'));
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon,
                title: message,
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                buttonsStyling: false,
                customClass: {
                    popup: 'rounded-lg shadow-lg',
                    title: 'text-sm font-medium text-gray-800'
                }
            });
        }
    </script>

    {# Toaster pour les addFlash du contrôleur #}
    {% for msg in app.flashes('success') %}<script>showFlash('success', '{{ msg|e('js') }}');</script>{% endfor %}
    {% for msg in app.flashes('info') %}<script>showFlash('info', '{{ msg|e('js') }}');</script>{% endfor %}
    {% for msg in app.flashes('warning') %}<script>showFlash('warning', '{{ msg|e('js') }}');</script>{% endfor %}
    {% for msg in app.flashes('danger') %}<script>showFlash('danger', '{{ msg|e('js') }}');</script>{% endfor %}
    {% for msg in app.flashes('error') %}<script>showFlash('error', '{{ msg|e('js') }}');</script>{% endfor %}
{% endblock %}

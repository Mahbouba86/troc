{% extends 'user_profile/base.html.twig' %}

{% block title %}Discussion – {{ annonce.titre }}{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto">

        {# ---------- Header annonce ---------- #}
        <div class="bg-white rounded-xl shadow p-4 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="rounded overflow-hidden bg-gray-200 shrink-0" style="width:60px; height:60px;">
                    {% set photo = (annonce.photos|length > 0) ? annonce.photos|first : null %}
                    {% if photo %}
                        <img src="{{ asset('uploads/photos/' ~ photo.filename) }}"
                             alt=""
                             style="width:60px; height:60px; object-fit:cover;">
                    {% else %}
                        <div class="flex items-center justify-center text-[8px] text-gray-500" style="width:30px; height:30px;">—</div>
                    {% endif %}
                </div>

                <div class="flex-1 min-w-0">
                    <div class="font-semibold truncate">{{ annonce.titre }}</div>
                    {% set s = annonce.status.value is defined ? annonce.status.value : annonce.status %}
                    <div class="mt-0.5">
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs
                        {{ s == 'AVAILABLE' ? 'bg-green-100 text-green-700' : '' }}
                        {{ s == 'RESERVED' ? 'bg-yellow-100 text-yellow-700' : '' }}
                        {{ s == 'PENDING_CONFIRMATION' ? 'bg-blue-100 text-blue-700' : '' }}
                        {{ s == 'FINISHED' ? 'bg-gray-200 text-gray-700' : '' }}">
                        {{ s }}
                    </span>
                    </div>
                    {% if other %}
                        <div class="text-xs text-gray-600 mt-0.5">
                            Avec
                            <a href="{{ path('user_profile', { id: other.id }) }}"
                               class="text-blue-600 hover:underline">
                                {{ other.username }}
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# Boutons d’action #}
                {% if other %}
                    <div class="flex gap-2">
                        {% if app.user and app.user.id != annonce.user.id and s == 'AVAILABLE' %}
                            <form method="post" action="{{ path('app_message_op', {id: annonce.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_ops }}">
                                <input type="hidden" name="op" value="reserve">
                                <input type="hidden" name="withId" value="{{ other.id }}">
                                <button class="px-3 py-2 rounded-lg bg-yellow-600 text-white text-sm">Réserver</button>
                            </form>
                        {% endif %}

                        {% if app.user and annonce.reservedBy is defined and annonce.reservedBy and annonce.reservedBy.id == app.user.id and s in ['RESERVED','PENDING_CONFIRMATION'] %}
                            <form method="post" action="{{ path('app_message_op', {id: annonce.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_ops }}">
                                <input type="hidden" name="op" value="cancel">
                                <input type="hidden" name="withId" value="{{ other.id }}">
                                <button class="px-3 py-2 rounded-lg border text-sm">Annuler</button>
                            </form>
                        {% endif %}

                        {% if app.user and app.user.id == annonce.user.id and s == 'RESERVED' and annonce.reservedBy is defined and annonce.reservedBy and annonce.reservedBy.id == other.id %}
                            <form method="post" action="{{ path('app_message_op', {id: annonce.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_ops }}">
                                <input type="hidden" name="op" value="give">
                                <input type="hidden" name="withId" value="{{ other.id }}">
                                <button class="px-3 py-2 rounded-lg bg-yellow-600 text-white text-sm">Donner</button>
                            </form>
                        {% endif %}

                        {% if app.user and annonce.reservedBy is defined and annonce.reservedBy and annonce.reservedBy.id == app.user.id and s == 'PENDING_CONFIRMATION' %}
                            <form method="post" action="{{ path('app_message_op', {id: annonce.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_ops }}">
                                <input type="hidden" name="op" value="confirm">
                                <input type="hidden" name="withId" value="{{ other.id }}">
                                <button class="px-3 py-2 rounded-lg bg-green-600 text-white text-sm">J’ai bien reçu</button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# ---------- Fil de discussion ---------- #}
        <div class="mt-4 space-y-3">
            {% if other is null %}
                <div class="text-center text-gray-500 text-sm">
                    Sélectionnez un interlocuteur (paramètre <code>withId</code>) pour afficher la conversation.
                </div>
            {% endif %}

            {% for m in messages %}
                {% set mine = (m.sender.id == app.user.id) %}
                <div class="flex {{ mine ? 'justify-end' : 'justify-start' }}">
                    <div class="max-w-[80%] rounded-2xl px-4 py-2 text-sm leading-relaxed
                        {{ mine ? 'bg-yellow-100' : 'bg-gray-100' }}">
                        {{ m.content }}
                        <div class="text-[10px] text-gray-500 mt-1">{{ m.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                </div>
            {% else %}
                {% if other %}
                    <div class="text-center text-gray-500 text-sm">Aucun message pour le moment.</div>
                {% endif %}
            {% endfor %}
        </div>

        {# ---------- Champ d’envoi ---------- #}
        <div class="sticky bottom-0 bg-white mt-4 p-3 border rounded-xl">
            {% if other %}
                {{ form_start(form, {'attr': {'class': 'flex items-center gap-2'}}) }}
                {{ form_widget(form.content, {
                    'attr': {
                        'class': 'flex-1 border rounded-lg px-3 py-2',
                        'placeholder': 'Votre message…'
                    }
                }) }}
                <button class="px-4 py-2 rounded-lg bg-yellow-600 text-white">Envoyer</button>
                {{ form_end(form) }}
            {% else %}
                <input type="text" disabled class="flex-1 border rounded-lg px-3 py-2 opacity-60" placeholder="Choisissez un interlocuteur pour écrire…">
            {% endif %}
        </div>
    </div>
{% endblock %}

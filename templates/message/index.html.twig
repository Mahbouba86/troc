{# templates/message/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Discussion – {{ annonce.titre }}{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto">

        {# Header annonce #}
        <div class="bg-white border-b border-gray-200 p-4 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <div class="bg-gray-200 shrink-0" style="width:60px; height:60px;">
                    {% set photo = (annonce.photos|length > 0) ? annonce.photos|first : null %}
                    {% if photo %}
                        <img src="{{ asset('uploads/photos/' ~ photo.filename) }}" alt="" class="w-full h-full object-cover">
                    {% endif %}
                </div>

                <div class="flex-1 min-w-0">
                    <div class="font-semibold truncate text-lg">{{ annonce.titre }}</div>

                    {# Statut (enum ou string) #}
                    {% set s_raw = attribute(annonce.status, 'value') ?? attribute(annonce.status, 'name') ?? '' %}
                    {% set s = s_raw|upper %}
                    <div class="mt-0.5">
                        <span class="inline-block px-2 py-0.5 border text-xs
                            {{ s == 'AVAILABLE' ? 'border-green-500 text-green-700' : '' }}
                            {{ s == 'RESERVED' ? 'border-yellow-500 text-yellow-700' : '' }}
                            {{ s == 'PENDING_CONFIRMATION' ? 'border-blue-500 text-blue-700' : '' }}
                            {{ s == 'FINISHED' ? 'border-gray-400 text-gray-600' : '' }}">
                            {{ s_raw }}
                        </span>
                    </div>

                    {% if other %}
                        <div class="text-xs text-gray-500 mt-0.5">
                            Avec
                            <a href="{{ path('user_profile', { id: other.id }) }}" class="text-blue-600 hover:underline">
                                {{ other.username }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Bandeau si une demande de finalisation est en cours #}
            {% if annonce.finishRequestedAt %}
                <div class="mt-2 text-xs px-2 py-1 rounded bg-blue-50 text-blue-800 border border-blue-200 inline-block">
                    Demande de finalisation envoyée le {{ annonce.finishRequestedAt|date('d/m/Y H:i') }} — en attente de confirmation.
                </div>
            {% endif %}
        </div>

        {# Fil de discussion #}
        <div class="mt-4 space-y-3">
            {% for m in messages %}
                {% set mine = (m.sender.id == app.user.id) %}
                <div class="flex {{ mine ? 'justify-end' : 'justify-start' }}">
                    <div class="max-w-[80%] border px-3 py-2 text-sm leading-relaxed
                        {{ mine ? 'border-yellow-400 bg-yellow-50 text-gray-800' : 'border-gray-300 bg-gray-50 text-gray-800' }}">
                        {{ m.content }}
                        <div class="text-[10px] text-gray-500 mt-1">{{ m.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                </div>
            {% else %}
                {% if other %}
                    <div class="text-center text-gray-500 text-sm">Aucun message pour le moment.</div>
                {% endif %}
            {% endfor %}
        </div>

        {# --- Calculs utilitaires pour les actions --- #}
        {% set isOwner = app.user and annonce.user and app.user.id == annonce.user.id %}

        {# Réceptionneur : reservedBy prioritaire, sinon une réservation avec statut RESERVED #}
        {% set receiverUser = annonce.reservedBy ?? null %}
        {% if not receiverUser %}
            {% for r in annonce.reservations %}
                {# rv_raw = value|name de l’enum, sinon null #}
                {% set rv_raw = attribute(r.statut, 'value') ?? attribute(r.statut, 'name') %}
                {% if rv_raw is not null %}
                    {% set rv = rv_raw|upper %}
                    {% if rv == 'RESERVED' and receiverUser is null %}
                        {% set receiverUser = r.user %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {% set isReceiver = app.user and receiverUser and app.user.id == receiverUser.id %}

        {# Zone d’envoi + actions #}
        <div id="reply" class="sticky bottom-0 bg-white border-t border-gray-200 mt-4 p-3 space-y-3">

            {# Formulaire message (quand il y a un interlocuteur) #}
            {% if other %}
                {{ form_start(form, {'attr': {'class': 'flex items-center gap-2'}}) }}
                {{ form_widget(form.content, {
                    'attr': {
                        'class': 'flex-1 border border-gray-300 px-3 py-2 text-sm',
                        'placeholder': 'Votre message…',
                        'autofocus': true
                    }
                }) }}
                <button class="px-4 py-2 bg-yellow-600 text-white text-sm hover:bg-yellow-700">Envoyer</button>
                {{ form_end(form) }}
            {% else %}
                <input type="text" disabled class="flex-1 border border-gray-200 px-3 py-2 text-sm opacity-60" placeholder="Choisissez un interlocuteur pour écrire…">
            {% endif %}

            {# --- Actions de finalisation depuis la discussion --- #}

            {# PROPRIÉTAIRE : si l’annonce est en statut RESERVED #}
            {% if isOwner and s == 'RESERVED' %}
                {% if annonce.finishRequestedAt is null %}
                    <form method="post"
                          action="{{ path('discussion_request_finish', { id: annonce.id }) }}"
                          class="inline-flex">
                        <input type="hidden" name="_token" value="{{ csrf_token('request_finish_' ~ annonce.id) }}">
                        {# <<< AJOUT : on passe l'interlocuteur actif #}
                        {% if other %}
                            <input type="hidden" name="receiverId" value="{{ other.id }}">
                        {% endif %}
                        <button class="px-3 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">
                            Finaliser le don
                        </button>
                    </form>
                {% else %}
                    <div class="text-sm text-gray-600">
                        Demande envoyée — en attente de confirmation du réceptionneur…
                    </div>
                {% endif %}
            {% endif %}


            {# RÉCEPTIONNEUR : si une demande est en cours #}
            {% if isReceiver and annonce.finishRequestedAt %}
                <form id="confirm-finish-form"
                      method="post"
                      action="{{ path('discussion_confirm_finish', { id: annonce.id }) }}"
                      class="hidden">
                    <input type="hidden" name="_token" value="{{ csrf_token('confirm_finished_' ~ annonce.id ~ '_' ~ app.user.id) }}">
                </form>

                <button id="confirm-finish-trigger"
                        class="px-3 py-2 bg-green-600 text-white text-sm rounded hover:bg-green-700">
                    Confirmer la réception
                </button>

                <script>
                    document.getElementById('confirm-finish-trigger')?.addEventListener('click', function (e) {
                        e.preventDefault();
                        Swal.fire({
                            title: 'Confirmer la réception ?',
                            text: 'Cette action finalisera le don.',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Oui, confirmer',
                            cancelButtonText: 'Annuler',
                            customClass: { popup: 'rounded-lg' }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                document.getElementById('confirm-finish-form')?.submit();
                            }
                        });
                    });
                </script>
            {% endif %}

            {# DEBUG (désactive-le après test)
            <pre class="text-xs text-gray-500">
              s={{ s }} (raw={{ s_raw }})
              owner={{ isOwner ? 'yes' : 'no' }}
              receiverUser={{ receiverUser ? receiverUser.id : 'null' }}
              isReceiver={{ isReceiver ? 'yes' : 'no' }}
              finishRequestedAt={{ annonce.finishRequestedAt ? annonce.finishRequestedAt|date('c') : 'null' }}
              me={{ app.user ? app.user.id : 'anon' }} | ownerId={{ annonce.user ? annonce.user.id : 'null' }}
            </pre>
            #}
        </div>
    </div>
{% endblock %}

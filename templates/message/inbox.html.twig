{# templates/message/inbox.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes messages{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto mt-10 px-4">
        <h1 class="text-2xl font-bold mb-6">Mes messages</h1>

        {% set threads = threads|default([]) %}

        {% if threads is empty %}
            <p class="text-gray-500">Aucun message pour le moment.</p>
        {% else %}
            <ul class="divide-y divide-gray-200 border border-gray-200">
                {% for key, t in threads %}
                    <li>
                        <a href="{{ path('app_message_index', { id: t.annonce.id, withId: t.other.id }) }}#reply"
                           class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50 transition">
                            <div class="min-w-0">
                                <p class="font-medium text-gray-900 truncate">
                                    Avec
                                    <span class="text-blue-600">{{ t.other.username }}</span>
                                    — à propos de
                                    <span class="text-blue-600">{{ t.annonce.titre }}</span>
                                </p>
                                <p class="text-sm text-gray-500">
                                    Dernier message le {{ t.lastAt|date('d/m/Y H:i') }}
                                </p>
                            </div>
                            <span class="px-3 py-1.5 bg-blue-600 text-white text-sm hover:bg-blue-700">
                                Répondre
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}

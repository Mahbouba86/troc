{% extends 'base.html.twig' %}

{% block title %}Modifier l'annonce{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto p-6">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-bold text-gray-900">
                Modifier votre annonce<br>
                <span class="text-blue-600">en toute simplicité</span>
            </h1>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6', 'enctype': 'multipart/form-data'}}) }}
        {{ form_errors(form) }}

        <div class="flex flex-col gap-2">
            <label class="font-semibold text-sm text-gray-700">Titre</label>
            {{ form_widget(form.titre, {'attr': {
                'placeholder': "Ex : Donne cours de maths",
                'class': 'px-4 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-500 text-sm'
            }}) }}
            {{ form_errors(form.titre) }}
        </div>

        <div class="flex flex-col gap-2">
            <label class="font-semibold text-sm text-gray-700">Description</label>
            {{ form_widget(form.description, {'attr': {
                'placeholder': "Décrivez votre annonce...",
                'class': 'px-4 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-500 text-sm'
            }}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="flex flex-col gap-2">
            <label class="font-semibold text-sm text-gray-700">Ville</label>
            {{ form_widget(form.ville, {'attr': {
                'placeholder': 'Ex : Paris',
                'class': 'px-4 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-500 text-sm'
            }}) }}
            {{ form_errors(form.ville) }}
        </div>

        <div class="flex flex-col gap-2">
            <label class="font-semibold text-sm text-gray-700">Catégorie</label>
            {{ form_widget(form.category, {'attr': {
                'class': 'px-4 py-2 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 text-sm'
            }}) }}
            {{ form_errors(form.category) }}
        </div>

        {# ----------- STATUT (de préférence via form.status si tu l'ajoutes) ----------- #}
        {% if form.status is defined %}
            <div class="flex flex-col gap-2">
                <label class="font-semibold text-sm text-gray-700">Statut</label>
                {{ form_widget(form.status, {'attr': {
                    'class': 'px-4 py-2 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 text-sm'
                }}) }}
                {{ form_errors(form.status) }}
            </div>
        {% else %}
            {# Fallback si tu n'as pas encore ajouté le champ status dans AnnonceType #}
            <div class="flex flex-col gap-2">
                <label class="font-semibold text-sm text-gray-700">Statut</label>
                <select name="status"
                        class="px-4 py-2 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-blue-500 text-sm">
                    <option value="">— Sélectionner —</option>
                    <option value="PENDING"
                            {% if annonce.status and annonce.status.value is defined and annonce.status.value == 'PENDING' %}selected{% endif %}>
                        En attente
                    </option>
                    <option value="RESERVED"
                            {% if annonce.status and annonce.status.value is defined and annonce.status.value == 'RESERVED' %}selected{% endif %}>
                        Réservée
                    </option>
                    <option value="ACTIVE"
                            {% if annonce.status and annonce.status.value is defined and annonce.status.value == 'ACTIVE' %}selected{% endif %}>
                        Active
                    </option>
                    <option value="ARCHIVED"
                            {% if annonce.status and annonce.status.value is defined and annonce.status.value == 'ARCHIVED' %}selected{% endif %}>
                        Archivée
                    </option>
                </select>
                <p class="text-xs text-gray-500">Conseil : ajoute le champ <code>status</code> dans le FormType avec
                    <code>EnumType</code> pour une gestion propre.</p>
            </div>
        {% endif %}

        {# ----------- PHOTOS MULTIPLES (upload) ----------- #}
        <div class="flex flex-col gap-2">
            <label class="font-semibold text-sm text-gray-700">Ajouter des photos</label>
            {{ form_widget(form.photos, {'attr': {
                'multiple': true,
                'class': 'block w-full text-sm text-gray-700 border border-gray-300 rounded-lg bg-white p-2'
            }}) }}
            {{ form_errors(form.photos) }}
        </div>

        {# ----------- Grille des photos + radio "photo principale" ----------- #}
        {% if annonce.photos|length > 0 %}
            <div class="mt-6">
                <h2 class="text-sm font-semibold text-gray-700 mb-2">Choisir la photo principale</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    {% for photo in annonce.photos %}
                        <label class="block border rounded-lg overflow-hidden cursor-pointer">
                            <img src="{{ asset('uploads/photos/' ~ photo.filename) }}" alt="photo"
                                 class="h-32 w-full object-cover">
                            <div class="p-2 flex items-center gap-2">
                                <input type="radio"
                                       name="mainPhoto"
                                       value="{{ photo.id }}"
                                       {% if photo.isMain %}checked{% endif %}>
                                <span class="text-xs text-gray-700">Photo principale</span>
                            </div>
                            <a href="{{ path('annonce_photo_delete',{photo: photo.id}) }}">supprimer la photo</a>
                        </label>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg text-center">
            Enregistrer les modifications
        </button>

        {{ form_end(form) }}
    </div>
{% endblock %}

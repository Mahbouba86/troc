{% extends 'base.html.twig' %}

{% block title %}{{ annonce.titre }}{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto mt-10 px-4">
        <article class="bg-white rounded-xl shadow p-6">

            <h1 class="text-3xl font-bold text-gray-900 mb-3">{{ annonce.titre }}</h1>

            {# statut (enum->value ou string) sans is defined #}
            {% set _status = attribute(annonce, 'status') %}
            {% set s = attribute(_status, 'value')|default(_status) %}

            {% set badge = {
                'Available': 'bg-green-100 text-green-800',
                'Reserved':  'bg-yellow-100 text-yellow-800',
                'Finished':  'bg-gray-200 text-gray-700',
                'Pending':   'bg-blue-100 text-blue-800',
                'Published': 'bg-indigo-100 text-indigo-800',
                'Drafted':   'bg-gray-100 text-gray-600'
            }[s]|default('bg-gray-100 text-gray-600') %}

            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium {{ badge }}">
      {{ {
          'Available': 'Disponible',
          'Reserved':  'Réservé',
          'Finished':  'Troc effectué',
          'Pending':   'En attente',
          'Published': 'Publiée',
          'Drafted':   'Brouillon'
      }[s] | default(s) }}
    </span>

            <p class="text-gray-700 mt-4">{{ annonce.description }}</p>

            <div class="text-sm text-gray-500 mt-3 space-y-1">
                <p>Posté le {{ annonce.createdAt|date('d/m/Y à H:i') }}</p>
                {% if annonce.ville %}
                    <p>Ville : <strong>{{ annonce.ville }}</strong></p>
                {% endif %}
                <p>
                    Proposé par :
                    <a href="{{ path('user_profile', { id: annonce.user.id }) }}" class="text-blue-600 hover:underline">
                        {{ annonce.user.username }}
                    </a>
                </p>
            </div>

            {% if app.user and app.user != annonce.user %}
                <div class="flex gap-4 mt-5">
                    <a href="{{ path('app_message_index', { id: annonce.id }) }}"
                       class="bg-yellow-600 hover:bg-yellow-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                        Contacter
                    </a>
                    {% include 'annonce/_reservation_button.html.twig' with {
                        annonce: annonce,
                        hasMyActiveReservation: hasMyActiveReservation
                    } %}
                </div>
            {% endif %}


            {% if app.user and app.user == annonce.user %}
                <div class="flex gap-4 mt-5">
                    <a href="{{ path('annonce_edit', { id: annonce.id }) }}"
                       class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                        Modifier l'annonce
                    </a>

                    <form method="post"
                          action="{{ path('annonce_delete', { id: annonce.id }) }}"
                          onsubmit="return confirm('Supprimer définitivement cette annonce ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_annonce_' ~ annonce.id) }}">
                        <button class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                            Supprimer
                        </button>
                    </form>
                </div>
            {% endif %}

            {# ================== GALERIE ================== #}
            <section class="mt-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-3">Galerie</h2>

                {# Détermine la photo principale via le getter + fallback first #}
                {% set mainPhoto = annonce.mainPhoto %}
                {% if mainPhoto is null %}
                    {% set mainPhoto = annonce.photos|first %}
                {% endif %}

                {# Grande image enfermée dans une DIV de hauteur fixe #}
                <div class="mx-auto max-w-3xl">
                    <div class="relative bg-gray-50 rounded-lg border overflow-hidden h-64">
                        {% if mainPhoto %}
                            {% set mainPath = asset('uploads/photos/' ~ mainPhoto.filename) %}
                            <a href="{{ mainPath }}" data-lightbox data-main-link class="block h-full">
                                <img src="{{ mainPath }}"
                                     alt="Photo principale"
                                     class="h-full w-full object-contain bg-white"
                                     data-main-img>
                            </a>
                        {% else %}
                            <div class="h-full flex items-center justify-center text-gray-400">Aucune image</div>
                        {% endif %}
                    </div>
                </div>

                {% if mainPhoto %}
                    {% set mainId = mainPhoto.id %}
                {% else %}
                    {% set mainId = null %}
                {% endif %}

                {# Miniatures enfermées dans une DIV de hauteur fixe #}
                {% if annonce.photos|length > 1 %}
                    <div class="mt-4 mx-auto max-w-3xl">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            {% for photo in annonce.photos %}
                                {% set src = asset('uploads/photos/' ~ photo.filename) %}
                                <button type="button"
                                        class="block w-full h-56 border border-gray-200 hover:border-blue-500 focus:outline-none {% if photo.id == mainId %}ring-2 ring-blue-500{% endif %}"
                                        data-thumb-src="{{ src }}"
                                        aria-label="Voir l'image">
                                    <div class="w-full h-full overflow-hidden">  {# conteneur carré, pas de rounded #}
                                        <img src="{{ src }}" alt="" class="w-full h-full object-cover">
                                    </div>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

            </section>
            {# ================== /GALERIE ================== #}

        </article>

        <div class="mt-10 bg-gray-50 p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Localisation</h2>
            <div class="w-full rounded overflow-hidden" style="height: 420px;">
                {{ ux_map(map, { style: 'height: 100%; width: 100%' }) }}
            </div>
        </div>
    </div>

    <dialog id="lightboxDialog" class="backdrop:bg-black/70 p-0 rounded-lg overflow-hidden">
        <img id="lightboxImg" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain">
    </dialog>

    <script>
        // Zoom (lightbox)
        document.addEventListener('click', function (e) {
            const a = e.target.closest('a[data-lightbox]');
            if (!a) return;
            e.preventDefault();
            const dlg = document.getElementById('lightboxDialog');
            const img = document.getElementById('lightboxImg');
            img.src = a.getAttribute('href');
            if (typeof dlg.showModal === 'function') {
                dlg.showModal();
                dlg.addEventListener('click', function onClick(ev) {
                    const rect = img.getBoundingClientRect();
                    if (ev.clientX < rect.left || ev.clientX > rect.right ||
                        ev.clientY < rect.top || ev.clientY > rect.bottom) {
                        dlg.close();
                    }
                }, { once: true });
                document.addEventListener('keydown', function onKey(ev) {
                    if (ev.key === 'Escape') dlg.close();
                }, { once: true });
            } else {
                window.open(a.getAttribute('href'), '_blank', 'noopener');
            }
        });

        // Switch image via miniatures
        document.addEventListener('DOMContentLoaded', function () {
            const mainLink = document.querySelector('[data-main-link]');
            const mainImg  = document.querySelector('[data-main-img]');
            if (!mainLink || !mainImg) return;
            document.querySelectorAll('[data-thumb-src]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const src = btn.dataset.thumbSrc;
                    mainImg.src = src;
                    mainLink.href = src;
                    document.querySelectorAll('[data-thumb-src]').forEach(b => {
                        b.classList.remove('ring-2','ring-blue-500');
                    });
                    btn.classList.add('ring-2','ring-blue-500');
                });
            });
        });
    </script>
{% endblock %}

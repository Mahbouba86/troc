{% extends 'base.html.twig' %}

{% block title %}{{ annonce.titre }}{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto mt-10 px-4 space-y-10">

        {# ================= HERO : image gauche / fiche droite ================= #}
        <section class="bg-white rounded-2xl shadow-sm ring-1 ring-black/5 overflow-hidden">
            <div class="grid md:grid-cols-2">

                {# --- Image principale --- #}
                {% set mainPhoto = annonce.mainPhoto ?: (annonce.photos|first) %}
                <div class="relative h-72 md:h-full">
                    {% if mainPhoto %}
                        <img
                            src="{{ asset('uploads/photos/' ~ mainPhoto.filename) }}"
                            alt="{{ annonce.titre }}"
                            class="absolute inset-0 w-full h-full object-cover">
                    {% else %}
                        <div class="absolute inset-0 flex items-center justify-center bg-gray-50 text-gray-400">
                            Aucune image
                        </div>
                    {% endif %}
                </div>

                {# --- Fiche droite --- #}
                <div class="p-6 lg:p-10">
                    <div class="flex items-start gap-3 mb-3">
                        <h1 class="text-2xl lg:text-3xl font-extrabold text-gray-900">{{ annonce.titre }}</h1>

                        {# Statut (enum ou string) #}
                        {% set rawStatus = attribute(annonce, 'status') %}
                        {% set statusVal = attribute(rawStatus, 'value') is defined ? attribute(rawStatus, 'value') : rawStatus %}
                        {% set s = (statusVal is not null) ? statusVal|lower : 'pending' %}
                        {% set badgeClass = {
                            'available': 'bg-green-100 text-green-800',
                            'reserved' : 'bg-yellow-100 text-yellow-800',
                            'finished' : 'bg-gray-200 text-gray-700',
                            'pending'  : 'bg-blue-100 text-blue-800'
                        }[s]|default('bg-gray-100 text-gray-700') %}
                        {% set badgeLabel = {
                            'available': 'Disponible',
                            'reserved' : 'Réservé',
                            'finished' : 'Troc effectué',
                            'pending'  : 'En attente'
                        }[s]|default(s|capitalize) %}
                        {% set isFinished = (s == 'finished') %}

                        <span class="shrink-0 inline-block px-3 py-1 rounded-full text-xs font-medium {{ badgeClass }}">
                          {{ badgeLabel }}
                        </span>
                    </div>

                    {% if annonce.description %}
                        <p class="text-gray-700 leading-relaxed mb-4">{{ annonce.description }}</p>
                    {% endif %}

                    <dl class="text-sm text-gray-600 space-y-1">
                        <div><dt class="inline text-gray-500">Posté le</dt> <dd class="inline font-medium">{{ annonce.createdAt|date('d/m/Y \\à H:i') }}</dd></div>
                        {% if annonce.ville %}
                            <div><dt class="inline text-gray-500">Ville</dt> <dd class="inline font-medium">{{ annonce.ville }}</dd></div>
                        {% endif %}
                        <div>
                            <dt class="inline text-gray-500">Proposé par</dt>
                            <dd class="inline">
                                <a href="{{ path('user_profile', { id: annonce.user.id }) }}" class="font-medium text-blue-700 hover:underline">
                                    {{ annonce.user.username }}
                                </a>
                            </dd>
                        </div>
                    </dl>

                    {# --- Actions (visiteur) --- #}
                    {% if app.user and app.user != annonce.user %}
                        <div class="flex flex-wrap gap-3 mt-6">
                            <a href="{{ path('app_message_index', { id: annonce.id }) }}"
                               class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold">
                                Contacter
                            </a>
                            {% include 'annonce/_reservation_button.html.twig' with {
                                annonce: annonce,
                                hasMyActiveReservation: hasMyActiveReservation
                            } %}
                        </div>
                    {% endif %}

                    {# --- Actions (propriétaire) --- #}
                    {% if app.user and app.user == annonce.user %}
                        <div class="flex flex-wrap gap-3 mt-6">
                            {% if not isFinished %}
                                <a href="{{ path('annonce_edit', { id: annonce.id }) }}"
                                   class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold">
                                    Modifier l'annonce
                                </a>
                            {% endif %}
                            <form method="post"
                                  action="{{ path('annonce_delete', { id: annonce.id }) }}"
                                  onsubmit="return false;"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_annonce_' ~ annonce.id) }}">
                                <button type="button"
                                        id="btn-delete"
                                        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-semibold">
                                    Supprimer l’annonce
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ================= GALERIE (3 vignettes) ================= #}
        {% set photos = annonce.photos|default([]) %}
        {% if photos|length > 0 %}
            <section>
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Galerie</h2>

                {# grande image cliquable (lightbox) #}
                {% set main = mainPhoto ?: (photos|first) %}

                {# miniatures #}
                {% if photos|length > 1 %}
                    <div class="grid sm:grid-cols-3 gap-6 max-w-5xl">
                        {% for p in photos|slice(0,3) %}
                            {% set src = asset('uploads/photos/' ~ p.filename) %}
                            <button type="button"
                                    class="rounded-xl overflow-hidden shadow-sm ring-1 ring-black/5 bg-white w-full h-56 {% if main and p.id == main.id %}ring-2 ring-blue-500{% endif %}"
                                    data-thumb-src="{{ src }}"
                                    aria-label="Voir l'image {{ loop.index }}">
                                <img src="{{ src }}" alt="" class="w-full h-full object-cover">
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        {% endif %}

        {# ================= CARTE ================= #}
        <section class="space-y-3">
            <h2 class="text-xl font-semibold text-gray-900">Localisation</h2>
            <div class="rounded-2xl overflow-hidden ring-1 ring-black/5 shadow-sm" style="height: 380px;">
                {{ ux_map(map, { style: 'height: 100%; width: 100%' }) }}
            </div>
        </section>
    </div>

    {# ================= Lightbox (dialog natif) ================= #}
    <dialog id="lightboxDialog" class="backdrop:bg-black/70 p-0 rounded-lg overflow-hidden">
        <img id="lightboxImg" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain">
    </dialog>

    <script>
        // Lightbox
        document.addEventListener('click', function (e) {
            const a = e.target.closest('a[data-lightbox]');
            if (!a) return;
            e.preventDefault();
            const dlg = document.getElementById('lightboxDialog');
            const img = document.getElementById('lightboxImg');
            img.src = a.getAttribute('href');
            if (typeof dlg.showModal === 'function') {
                dlg.showModal();
                dlg.addEventListener('click', function onClick(ev) {
                    const r = img.getBoundingClientRect();
                    if (ev.clientX < r.left || ev.clientX > r.right || ev.clientY < r.top || ev.clientY > r.bottom) dlg.close();
                }, { once: true });
                document.addEventListener('keydown', function onKey(ev) { if (ev.key === 'Escape') dlg.close(); }, { once: true });
            } else {
                window.open(a.getAttribute('href'), '_blank', 'noopener');
            }
        });

        // Switch via miniatures
        document.addEventListener('DOMContentLoaded', function () {
            const mainLink = document.querySelector('[data-main-link]');
            const mainImg  = document.querySelector('[data-main-img]');
            if (!mainLink || !mainImg) return;
            document.querySelectorAll('[data-thumb-src]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const src = btn.dataset.thumbSrc;
                    mainImg.src = src;
                    mainLink.href = src;
                    document.querySelectorAll('[data-thumb-src]').forEach(b => b.classList.remove('ring-2','ring-blue-500'));
                    btn.classList.add('ring-2','ring-blue-500');
                });
            });
        });

        // SweetAlert2 suppression
        const delBtn = document.getElementById('btn-delete');
        if (delBtn) {
            const s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11'; s.onload = () => {
                delBtn.addEventListener('click', () => {
                    Swal.fire({
                        title: 'Supprimer cette annonce ?',
                        text: 'Cette action est irréversible.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Oui, supprimer',
                        cancelButtonText: 'Annuler'
                    }).then((r) => { if (r.isConfirmed) delBtn.closest('form').submit(); });
                });
            }; document.body.appendChild(s);
        }
    </script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Annonces disponibles{% endblock %}

{% block body %}
    <div class="mb-12 max-w-7xl mx-auto px-4">
        <h2 class="text-2xl font-bold mb-6 text-gray-800 text-center">Catégories populaires</h2>

        <div class="flex flex-wrap justify-center gap-6">
            {% for category in categories %}
                <a href="{{ path('annonce_index', { 'category': category.id }) }}"
                   class="flex flex-col items-center min-w-[100px] group hover:opacity-80 transition">
                    <div class="w-24 h-24 rounded-full overflow-hidden shadow-md border border-gray-200">
                        <img src="{{ asset('uploads/categories/' ~ category.image) }}"
                             alt="{{ category.name }}"
                             class="object-cover w-full h-full">
                    </div>
                    <p class="mt-2 text-sm font-medium text-gray-700 text-center">{{ category.name }}</p>
                </a>
            {% endfor %}
        </div>
    </div>

    {# ---------- Zone Annonces + Recherche instantanée ---------- #}
    <div class="max-w-7xl mx-auto px-4 py-10"
         data-controller="annonce-search"
         data-annonce-search-url-value="{{ path('annonce_search') }}"
    >
        <div class="text-center mb-10">
            <h1 class="text-3xl font-bold text-gray-900">
                Nos annonces<br>
                <span class="text-blue-800">Découvrez ce que la communauté donne</span>
            </h1>
        </div>

        {# 🔎 Barre de recherche instantanée #}
        <div class="bg-gray-100 p-6 rounded-lg shadow mb-10">
            {# Champ libre pour le NOM D’OBJET (ex. “vélo”) #}
            <div class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1">
                    <label class="block text-sm font-medium mb-1">Objet</label>
                    <input
                        type="text"
                        placeholder="Rechercher un objet (ex. vélo)…"
                        class="w-full px-3 py-2 rounded border"
                        data-annonce-search-target="q"
                        data-action="input->annonce-search#debounceFetch"
                        autocomplete="off"
                    >
                </div>

                {# On garde tes champs existants, branchés en instantané #}
                <div class="flex-1">
                    {{ form_label(form.ville) }}
                    {{ form_widget(form.ville, {
                        attr: {
                            class: 'w-full px-3 py-2 rounded border',
                            'data-annonce-search-target': 'ville',
                            'data-action': 'input->annonce-search#debounceFetch change->annonce-search#debounceFetch'
                        }
                    }) }}
                </div>

                <div class="flex-1">
                    {{ form_label(form.category) }}
                    {{ form_widget(form.category, {
                        attr: {
                            class: 'w-full px-3 py-2 rounded border',
                            'data-annonce-search-target': 'category',
                            'data-action': 'change->annonce-search#debounceFetch'
                        }
                    }) }}
                </div>

                {# Bouton masqué (fallback si tu veux garder le form classique plus tard) #}
                <div class="self-end hidden">
                    <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Rechercher</button>
                </div>
            </div>
        </div>

        {# 🧩 Conteneur des résultats : rendu initial + mises à jour AJAX #}
        <div id="annonces-list" data-annonce-search-target="results">
            {% include 'annonce/_annonce_cards.html.twig' with { annonces: annonces } %}
        </div>
    </div>
{% endblock %}
